{
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext"],
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "noImplicitAny": true,
    "moduleResolution": "Node",
    "sourceMap": false,
    "outDir": "dist",
    "baseUrl": "."
  },
  "include": ["./src", "./package.json"],
  "exclude": ["./node_modules", "./dist"]
}
